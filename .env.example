# npm start creates a private .env with random passwords on the first local start.
# If you copy this example yourself, replace all three password placeholders first.
POSTGRES_PASSWORD=replace_with_a_random_hex_password
APP_DB_PASSWORD=replace_with_a_second_random_hex_password
OWNER_PASSWORD=replace_with_at_least_12_characters
OWNER_BUSINESS_ID=00000000-0000-4000-8000-000000000001
OWNER_BUSINESS_NAME=StockCast Store
OWNER_DISPLAY_NAME=Store Owner
OWNER_EMAIL=owner@example.com
# Provenance of this business's records. Select partner only for authorized real data.
OWNER_DATA_ORIGIN=demo
APP_ENV=development
APP_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Hosting: APP_ENV=production, APP_ADDRESS=your.domain, HTTP_PORT=80, HTTPS_PORT=443.

CORS_ORIGIN=http://localhost:8080

# Optional password-recovery and staff-invitation email, configured on the API only.
# PUBLIC_APP_URL defaults to CORS_ORIGIN; set it to the website recipients can open.
# Hosted links must use your public HTTPS website URL.
PUBLIC_APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Keep SMTP credentials in the private .env; never use browser VITE_ variables.

# Optional Google web OAuth client; secret stays on the server.
# Configure the same exact redirect URI in Google Cloud. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

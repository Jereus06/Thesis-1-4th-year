# Copy this file to .env and replace the password with your own local PostgreSQL password.
DATABASE_URL=postgresql://stockcast:change_me@localhost:5432/stockcast
PORT=3001
NODE_ENV=development
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:5173
DATABASE_SSL=false

# Used only by `npm run db:bootstrap-owner`. Replace every placeholder.
OWNER_BUSINESS_ID=00000000-0000-4000-8000-000000000001
OWNER_BUSINESS_NAME=StockCast Demo Store
OWNER_DATA_ORIGIN=demo
OWNER_EMAIL=owner@example.test
OWNER_DISPLAY_NAME=Demo Owner
OWNER_PASSWORD=change-this-demo-password

SESSION_HOURS=12
ARTIFACT_DIR=data/models
FORECAST_POLL_SECONDS=5

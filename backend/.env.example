# Copy this file to .env and replace the password with your own local PostgreSQL password.
DATABASE_URL=postgresql://stockcast:replace_with_your_local_database_password@localhost:5432/stockcast
PORT=3001
APP_ENV=development
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
DATABASE_SSL=false

# Used only by `python -m backend.app.bootstrap_owner`. Replace every placeholder.
OWNER_BUSINESS_ID=00000000-0000-4000-8000-000000000001
OWNER_BUSINESS_NAME=StockCast Store
OWNER_DATA_ORIGIN=demo
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Store Owner
OWNER_PASSWORD=replace_with_at_least_12_characters

# Optional Google web OAuth client; secret stays on the server.
# Configure the same exact redirect URI in Google Cloud. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Optional account-maintenance email. Keep credentials private; tests use a mock transport.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

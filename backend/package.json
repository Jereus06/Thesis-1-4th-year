{
  "name": "stockcast-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run db:check",
    "db:check": "node db/check-schema.mjs",
    "db:bootstrap-demo": "node src/bootstrap-demo.ts",
    "db:migrate": "node src/migrate-cli.ts",
    "demo": "node src/main.ts",
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "typescript": "^5.7.0"
  }
}